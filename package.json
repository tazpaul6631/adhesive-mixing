{
  "name": "exit-interview",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "postinstall": "patch-package",
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "build:web": "vue-tsc && vite build",
    "cap:sync:android": "npx cap sync android",
    "cap:sync:ios": "npx cap sync ios && node scripts/fix-ios-spm.mjs",
    "build:android": "npm run build:web && npm run cap:sync:android && node scripts/build-android.mjs",
    "build:android:signed": "npm run build:android && bash scripts/sign-android-apk.sh",
    "build:ios": "npm run build:web && npm run cap:sync:ios && node scripts/build-ios.mjs",
    "build:ios:archive": "npm run build:web && npm run cap:sync:ios && node scripts/build-ios.mjs archive",
    "open:android": "npx cap open android",
    "open:ios": "npx cap open ios",
    "preview": "vite preview",
    "test:e2e": "cypress run",
    "test:unit": "vitest"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.0",
    "@capacitor-mlkit/barcode-scanning": "^8.0.1",
    "@capacitor/android": "^8.3.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/camera": "^8.1.0",
    "@capacitor/core": "^8.3.1",
    "@capacitor/device": "^8.0.2",
    "@capacitor/dialog": "^8.0.1",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "8.3.1",
    "@capacitor/keyboard": "8.0.2",
    "@capacitor/local-notifications": "^8.0.2",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "8.0.2",
    "@ionic/vue": "^8.0.0",
    "@ionic/vue-router": "^8.0.0",
    "@kalimahapps/vue-icons": "^1.9.6",
    "@primeuix/themes": "^2.0.3",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^14.2.1",
    "axios": "^1.15.0",
    "cordova-plugin-android-permissions": "^1.1.5",
    "cordova-plugin-bluetooth-serial": "^0.4.7",
    "cordova-plugin-serial": "^0.0.3",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.20",
    "ionicons": "^7.0.0",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "primeflex": "^4.0.0",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.5",
    "vee-validate": "^4.15.1",
    "vue": "^3.3.0",
    "vue-i18n": "^11.3.2",
    "vue-router": "^4.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@capacitor/cli": "8.3.1",
    "@types/crypto-js": "^4.2.2",
    "@vitejs/plugin-legacy": "^5.0.0",
    "@vitejs/plugin-vue": "^4.0.0",
    "@vue/test-utils": "^2.3.0",
    "cypress": "^13.5.0",
    "jsdom": "^22.1.0",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "prettier": "^3.8.2",
    "sass": "^1.99.0",
    "terser": "^5.4.0",
    "typescript": "~5.9.0",
    "vite": "^5.0.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^0.34.6",
